# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required. The bearer token every caller must send, at least 16 characters long.
# The service refuses to start with a placeholder such as changeme.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCORD_API_SECRET=

# Optional settings follow. The values shown are the defaults.

# Path to the SQLite database file.
# SCHEDULER_DB_PATH=/data/scheduler.db

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# LOG_LEVEL=INFO

# Maximum number of delivery retries before a reminder is marked failed. It must be 0 or more.
# DISPATCHER_MAX_RETRIES=3

# Hostnames that bot_callback_url may point to, comma-separated or as a JSON list.
# While this is empty, every bot callback is refused with 422.
# An example value is bot.example.com,localhost.
# ALLOWED_CALLBACK_HOSTS=

# What startup does with a reminder that came due while the service was down.
# fire delivers it at once. fail marks it failed and logs it.
# MISSED_REMINDER_POLICY=fire
