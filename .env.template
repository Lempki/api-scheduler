# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required. The bearer token every caller must send, at least 16 characters long.
# The service refuses to start with a placeholder such as changeme.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCORD_API_SECRET=

# Optional settings follow. The values shown are the defaults.

# Path to the SQLite database file.
# SCHEDULER_DB_PATH=/data/scheduler.db

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# LOG_LEVEL=INFO

# Maximum number of delivery retries before marking as failed.
# DISPATCHER_MAX_RETRIES=3
